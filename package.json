{
  "name": "nekomi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test:browser": "python3 tests/theme_audit.py",
    "dev:personal": "node scripts/personal.mjs dev",
    "build:personal": "node scripts/personal.mjs build",
    "test:config": "node --test tests/config.test.mjs",
    "config:docs": "node scripts/config-docs.mjs",
    "licenses": "node scripts/licenses.mjs",
    "prebuild": "npm run licenses",
    "test:social": "node --test tests/social.test.mjs",
    "test:p3": "python3 tests/p30_audit.py",
    "test:comments": "node --test tests/comments.test.mjs",
    "test:comments:browser": "python3 tests/comments_audit.py --stress",
    "test:comments:edges": "python3 tests/comments_edges.py",
    "test:reading": "node --test tests/reading.test.mjs",
    "test:reading:browser": "python3 tests/reading_audit.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "katex": "0.16.47",
    "mdui": "2.1.5",
    "mermaid": "12.2.0",
    "photoswipe": "5.4.4",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
