---
import { config, ui } from '../../config/site';
import type { CommentContent } from './types';
import Decoration from '../../components/Decoration.astro';
interface Props { content: CommentContent; prefix?: string }
const { content, prefix = '' } = Astro.props;
const enabled = !['none', 'link'].includes(config.comments.provider) && content.comments !== false;
---
{enabled && (
  <section id={prefix + 'comments'} class="article-comments" data-comments-section data-comments-id={content.id} data-comments-key={content.key} data-state="idle" aria-labelledby={prefix + 'comments-heading'}>
    <mdui-divider></mdui-divider>
    <header class="comments-heading">
      <h2 id={prefix + 'comments-heading'}>{ui.comments.title}</h2>
      <span data-comment-count hidden></span>
    </header>
    <p role="status" aria-live="polite" data-comments-status>{ui.comments.idle}</p>
    <mdui-button variant="tonal" data-comment-retry hidden>{ui.comments.retry}</mdui-button>
    <div class="comments-body" style={`--decoration-width:${config.appearance.decorations.comments.width}px`}>
      <div class="comments-mount" data-comments-mount aria-busy="false"></div>
      <Decoration kind="comments" />
    </div>
    <noscript><p>{ui.comments.noScript}</p></noscript>
  </section>
)}
