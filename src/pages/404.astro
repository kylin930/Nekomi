---
import SiteLayout from '../layouts/SiteLayout.astro';
import { config, ui } from '../config/site';
import { withBase } from '../lib/urls';
import Icon from '../components/Icon.astro';
---
<SiteLayout title={ui.reading.missingPage + ' · ' + config.site.name} page="error">
  <mdui-card id="article-error" variant="outlined" class="reader-error" data-kind="not-found"><Icon name="article--outlined" /><h1 id="article-error-title">{ui.reading.missingPage}</h1><p id="article-error-message">{ui.reading.missingDescription}</p><mdui-button variant="tonal" href={withBase('') + '#recent'}>{ui.common.backToPosts}</mdui-button></mdui-card>
</SiteLayout>
