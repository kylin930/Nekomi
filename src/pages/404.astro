---
import SiteLayout from '../layouts/SiteLayout.astro';
import { config } from '../config/site';
import { withBase } from '../lib/urls';
import Icon from '../components/Icon.astro';
---
<SiteLayout title={'页面未找到 · ' + config.site.name} page="error">
  <mdui-card id="article-error" variant="outlined" class="reader-error" data-kind="not-found"><Icon name="article--outlined" /><h1 id="article-error-title">页面未找到</h1><p id="article-error-message">链接可能已失效，请返回文章列表。</p><mdui-button variant="tonal" href={withBase('') + '#recent'}>返回文章列表</mdui-button></mdui-card>
</SiteLayout>
