---
import type { GetStaticPaths } from 'astro';
import BlogHome from '../../components/BlogHome.astro';
import { getPosts } from '../../lib/posts';
import { listing } from '../../lib/pagination';
import { publishing } from '../../config/publishing.mjs';
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: publishing.pageSize }).filter(item => item.props.page.currentPage > 1).map(item => ({ ...item, props: { feed: listing(posts, item.props.page.currentPage) } }));
}) satisfies GetStaticPaths;
const { feed } = Astro.props;
---
<BlogHome feed={feed} />
