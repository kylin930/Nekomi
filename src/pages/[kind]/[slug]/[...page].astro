---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ArticleFeed from '../../../components/ArticleFeed.astro';
import { getPosts, facets } from '../../../lib/posts';
import { listing } from '../../../lib/pagination';
import { publishing } from '../../../config/publishing.mjs';
import { config, ui, message } from '../../../config/site';
import { monthLabel } from '../../../lib/format';
import { facetUrl } from '../../../lib/urls';
import { canIndex } from '../../../lib/seo';
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return ['categories', 'tags', 'archive'].filter(kind => kind === 'archive' || config.content[kind as 'categories' | 'tags']).flatMap(kind => facets(posts, kind as 'categories' | 'tags' | 'archive').flatMap(group =>
    paginate(group.posts, { pageSize: publishing.pageSize, params: { kind, slug: group.slug } }).map(item => ({ ...item, props: { feed: listing(group.posts, item.props.page.currentPage, kind + '/' + group.slug), group } }))));
}) satisfies GetStaticPaths;
const { feed, group } = Astro.props;
const labels: Record<string, string> = { categories: ui.navigation.categories, tags: ui.navigation.tags, archive: ui.navigation.archive };
const kind = Astro.params.kind!;
const title = kind === 'archive' ? monthLabel(group.name) : group.name;
---
<SiteLayout title={title + (feed.number > 1 ? ' · ' + message(ui.common.page, { page: feed.number }) : '') + ' · ' + config.site.name} description={message(ui.navigation.facetDescription, { title })} page="home" noindex={!canIndex(feed.items)}>
  <nav class="listing-breadcrumb" aria-label={ui.navigation.browse}><mdui-button variant="text" href={facetUrl(kind)}>{message(ui.navigation.allFacet, { label: labels[kind] })}</mdui-button></nav>
  <ArticleFeed feed={feed} title={title} />
</SiteLayout>
