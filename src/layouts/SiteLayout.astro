---
import { ClientRouter } from 'astro:transitions';
import { config, ui } from '../config/site';
import WebFonts from '../components/WebFonts.astro';
import TopLinks from '../components/TopLinks.astro';
import { getPosts, postMetadata } from '../lib/posts';
import { base } from '../lib/urls';
import { pageTransition } from '../lib/transitions';
import Navigation from '../components/Navigation.astro';
import Wallpaper from '../components/Wallpaper.astro';
import Decoration from '../components/Decoration.astro';
import Sidebar from '../components/Sidebar.astro';
import ThemeControl from '../components/ThemeControl.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { canIndex } from '../lib/seo';
import { publishing } from '../config/publishing.mjs';
import type { Post } from '../lib/posts';
import { withBase, assetUrl } from '../lib/urls';
import { createHash } from 'node:crypto';
import 'mdui/mdui.css';
import '../styles/tokens.css';
import '../styles/main.css';
import '../styles/home.css';
import '../styles/article.css';
import '../styles/transitions.css';
import '../styles/decorations.css';
interface Props { title: string; description?: string; page?: 'home' | 'article' | 'error' | 'page'; currentId?: string; post?: Post; noindex?: boolean }
const { title, description = config.site.tagline || config.site.intro || config.site.name, page = 'home', currentId, post } = Astro.props;
const posts = await getPosts();
const noindex = Astro.props.noindex ?? (page === 'error' || !canIndex(post ? [post] : posts));
const a = config.appearance;
const appleTouchIcon = assetUrl(config.site.appleTouchIcon);
const themeTokens = `--nekomi-latest-tint:${a.preset === 'minimal' ? '0%' : '18%'};--reader-width:${config.layout.readerWidth}px;--site-width:${config.layout.width}px;--sidebar-width:${config.layout.sidebarWidth}px;--reading-font:${a.font};--identity-font:${a.headingFont};--brand-font:${a.brandFont};--nekomi-shape-card:${a.radius}px;--nekomi-shape-pressed:${Math.max(8, a.radius - 4)}px`;
const data = { ...config, posts: posts.map(postMetadata), base, pageSize: publishing.pageSize };
const contentVersion = createHash('sha256').update(JSON.stringify(data)).digest('hex').slice(0, 16);
---
<!doctype html>
<html lang={publishing.language} style={themeTokens} class={'mdui-theme-' + a.mode} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} noindex={noindex} post={post} />
    <WebFonts />
    {config.features.rss && <link rel="alternate" type="application/rss+xml" title={config.site.name + ' RSS'} href={withBase('rss.xml')} />}
    <meta name="color-scheme" content="light dark" />
    <style is:global>
      html { background: #fdf7ff; color-scheme: light; }
      html.mdui-theme-dark { background: #19151f; color-scheme: dark; }
      @media (prefers-color-scheme: dark) { html.mdui-theme-auto { background: #19151f; color-scheme: dark; } }
    </style>
    <link rel="icon" href={assetUrl(config.site.favicon) || 'data:,'} />
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    <script is:inline define:vars={{ defaultMode: a.mode }}>
      try {
        var savedTheme = window.NekomiTheme?.getMode() || localStorage.getItem('nekomi-theme');
        document.documentElement.classList.remove('mdui-theme-light', 'mdui-theme-dark', 'mdui-theme-auto');
        document.documentElement.classList.add('mdui-theme-' + (['light', 'dark', 'auto'].includes(savedTheme) ? savedTheme : defaultMode));
      } catch (_) { /* 无存储权限时使用配置默认值，单例在导航后恢复当前内存偏好。 */ }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Icons&family=Material+Icons+Outlined&display=swap" />
    {config.analytics.enabled && <script is:inline async data-website-id={config.analytics.websiteId} src={config.analytics.scriptUrl} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body data-page={page} data-post-id={currentId}>
    <Wallpaper />
    <a class="skip-link" href="#main-content">{ui.navigation.skip}</a>
    <Navigation posts={posts} currentId={currentId} />
    <div class:list={['site-layout', { 'reading-layout': page === 'article' }]}>
      <aside class="sidebar" aria-label={ui.navigation.siteInfo} data-site-sidebar transition:persist="desktop-sidebar" transition:animate="none">
        <Sidebar context="desktop" posts={posts} currentId={currentId} />
        <div class="sidebar-settings"><span>{ui.sidebar.appearance}</span><ThemeControl /></div>
        <Decoration kind="sidebar" />
      </aside>
      <main id="main-content" tabindex="-1" aria-busy="false" transition:name="page-content" transition:animate={pageTransition}>
        <TopLinks />
        <slot />
        <Footer />
      </main>
      <slot name="toc" />
    </div>
    <script id="site-data" type="application/json" data-version={contentVersion} set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
    <script>import '../scripts/runtime.js';</script>
  </body>
</html>
