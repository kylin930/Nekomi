---
import type { Post } from '../lib/posts';
import { postUrl } from '../lib/urls';
interface Props { post: Post; description: string; active?: boolean }
const { post, description, active } = Astro.props;
---
<mdui-list-item rounded href={postUrl(post.id)} data-post={post.id} headline={post.data.title} headline-line="2" description={description} active={active || undefined}></mdui-list-item>
