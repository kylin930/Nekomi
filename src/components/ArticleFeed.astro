---
import { config, mainTabs } from '../config/site';
import type { Listing } from '../lib/pagination';
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
interface Props { feed: Listing; title?: string; description?: string }
const { feed, title = mainTabs.find(t => t.id === 'recent')!.label, description = config.home.description || `${feed.total} 篇文章 · 按时间收录` } = Astro.props;
---
<section data-listing data-title={title} data-description={description} data-next={feed.next} data-page={feed.number} data-pages={feed.pages} data-total={feed.total}>
  <div class="view-heading"><div><p class="eyebrow">{config.home.eyebrow}</p><h1 id="feed-title" tabindex="-1">{title}</h1><p id="feed-summary" class="view-description" role="status" aria-live="polite">{description}</p></div></div>
  <div id="search-toolbar" class="search-toolbar" hidden><mdui-chip id="search-chip" variant="input" deletable></mdui-chip><mdui-button variant="text" data-clear-search>清除搜索</mdui-button></div>
  {!feed.total && <mdui-card variant="outlined" class="empty-state" data-content-empty><Icon name="edit_note" /><h2>{config.home.emptyTitle}</h2><p>{config.home.emptyDescription}</p></mdui-card>}
  <div id="post-list" class="post-list">{feed.items.map((post, index) => <PostCard post={post} latest={feed.number === 1 && index === 0} />)}</div>
  <mdui-card id="search-empty" variant="outlined" class="empty-state" hidden><Icon name="search_off--outlined" /><h2>暂时没有找到</h2><p>换个关键词试试，或者回到全部文章。</p><mdui-button variant="tonal" data-clear-search>查看全部文章</mdui-button></mdui-card>
  <div id="feed-sentinel" class="feed-loading"><p id="feed-status" role="status" aria-live="polite">{feed.next ? `第 ${feed.number} / ${feed.pages} 页` : '已经读到最后了'}</p><mdui-button id="load-more" variant="tonal" hidden>加载更多</mdui-button></div>
  <nav id="feed-pagination" class="feed-pagination" aria-label="文章分页">{feed.previous && <a href={feed.previous} rel="prev">上一页</a>}<span data-page-label>第 {feed.number} / {feed.pages} 页</span>{feed.next && <a href={feed.next} rel="next" data-page-next>下一页</a>}</nav>
</section>
