---
import { builtinCapabilities } from '../integrations/comments/capabilities';
import { commentTime } from '../lib/format';
import { config, ui, message } from '../config/site';
import type { Post } from '../lib/posts';
import { dateLabel, externalUrl, postUrl, navigationUrl, withBase } from '../lib/urls';
import Avatar from './Avatar.astro';
import SearchField from './SearchField.astro';
import PostListItem from './PostListItem.astro';
import FriendItem from './FriendItem.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
interface Props { posts: Post[]; context: 'desktop' | 'mobile'; currentId?: string }
const { posts, context, currentId } = Astro.props;
const prefix = 'side-' + context;
const { site } = config;
const labels = { updates: ui.sidebar.updates, friends: ui.sidebar.friends, comments: ui.sidebar.comments };

const modules = config.layout.modules.filter(id => id !== 'search' || config.features.search);
const updates = [...posts].sort((a, b) => (b.data.updated || b.data.date).localeCompare(a.data.updated || a.data.date));
const friends = config.friends.filter(f => externalUrl(f.url));
const dynamicComments = !['none', 'link'].includes(config.comments.provider);
const liveRecent = config.comments.recent && (config.comments.provider === 'custom' || (config.comments.provider in builtinCapabilities && builtinCapabilities[config.comments.provider as keyof typeof builtinCapabilities].recent));
const comments = (dynamicComments ? [] : config.comments.items.filter(c => c.demo)).filter(c => c.author.trim() && c.excerpt.trim() && posts.some(p => p.id === c.postId && p.data.comments !== false)).sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
const tabs = config.layout.sidebarTabs.filter(id => (id !== 'updates' || config.layout.recentPostsLimit > 0) && (id !== 'friends' || config.layout.friendsPreviewLimit > 0) && (id !== 'comments' || config.comments.recent && (liveRecent || comments.length > 0)));

---
<div data-sidebar={context}>
  {modules.map(module => <>
  {module === 'profile' && <>  <div class="profile">
    <div class="profile-brand">
      <Avatar src={site.avatar} fallback={site.avatarFallback} label={site.avatarAlt} />
      <div><p class="site-name">{site.name}</p>{site.tagline.trim() && <p class="site-tagline">{site.tagline}</p>}</div>
    </div>
    {site.intro.trim() && <p class="site-intro">{site.intro}</p>}
  </div>
</>}
  {module === 'social' && <SocialLinks />}
  {module === 'search' && <SearchField />}
  {module === 'tabs' && tabs.length > 0 &&
  <mdui-tabs class="sidebar-tabs" value={tabs[0]} variant="secondary" full-width aria-label={ui.sidebar.content}>
    {tabs.map(id => <mdui-tab value={id} id={prefix + '-' + id} role="tab" aria-controls={prefix + '-' + id + '-panel'}>{labels[id]}</mdui-tab>)}
    {tabs.map(id => <>
    {id === 'updates' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="updates" id={prefix + '-updates-panel'} role="tabpanel" aria-labelledby={prefix + '-updates'}>
      <div class="side-panel-content">{!updates.length && <p class="friend-empty">{ui.home.noArticles}</p>}
        <mdui-list>{updates.slice(0, config.layout.recentPostsLimit).map(post => <PostListItem post={post} description={dateLabel(post.data.date)} active={post.id === currentId} />)}</mdui-list>
      </div>
    </mdui-tab-panel>}
    {id === 'friends' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="friends" id={prefix + '-friends-panel'} role="tabpanel" aria-labelledby={prefix + '-friends'}>
      <div class="side-panel-content">{friends.length > 0 && <div class="side-panel-heading"><span>{message(ui.common.siteCount, { count: friends.length })}</span><mdui-button variant="text" href={config.friendsPage.enabled ? withBase('friends/') : undefined} data-friends-all={!config.friendsPage.enabled || undefined}>{ui.common.viewAll}<Icon name="arrow_forward" slot="end-icon" /></mdui-button></div>}
        {friends.length ? <mdui-list class="friend-list">{friends.slice(0, config.layout.friendsPreviewLimit).map(friend => <FriendItem friend={friend} />)}</mdui-list> : <p class="friend-empty">{ui.sidebar.noFriends}</p>}
      </div>
    </mdui-tab-panel>}
    {id === 'comments' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="comments" id={prefix + '-comments-panel'} role="tabpanel" aria-labelledby={prefix + '-comments'}>
      {liveRecent ? <div class="side-panel-content" data-comments-recent><p class="comments-note" role="status" aria-live="polite" data-comments-recent-status>{ui.comments.recentIdle}</p><mdui-list class="comment-list" data-comments-recent-list></mdui-list><mdui-button variant="text" data-comments-recent-retry hidden>{ui.comments.recentRetry}</mdui-button></div> : <>
      <div class="side-panel-content"><div class="side-panel-heading"><span>{ui.sidebar.exampleComments}</span><span>{message(ui.comments.count, { count: comments.length })}</span></div>
        {comments.length ? <>
          <p class="comments-note">{config.comments.anchorsEnabled ? ui.sidebar.openComment : ui.sidebar.openCommentPost}</p>
          <mdui-list class="comment-list">{comments.slice(0, config.comments.recentLimit).map(comment => {
            const post = posts.find(p => p.id === comment.postId)!;
            const href = postUrl(post.id) + (config.comments.anchorsEnabled && comment.anchor ? '#' + encodeURIComponent(comment.anchor) : '');
            return <mdui-list-item rounded href={href} data-demo-comment={comment.demo || undefined}>
              <Avatar class="comment-avatar" slot="icon" src={comment.avatar} fallback={Array.from(comment.author)[0]} label={comment.author} />
              <div class="comment-copy"><div class="comment-byline"><strong>{comment.author}</strong><time datetime={comment.createdAt}>{commentTime(comment.createdAt)}</time></div><p class="comment-excerpt">{comment.excerpt}</p><p class="comment-post">{post.data.title}</p></div>
            </mdui-list-item>;
          })}</mdui-list>
        </> : <p class="friend-empty">{ui.sidebar.noComments}</p>}
      </div>
      </>}
    </mdui-tab-panel>}
    </>)}
  </mdui-tabs>}
  </>)}
  {(config.navigation.links.length > 0 || config.friendsPage.enabled && config.friendsPage.navigation) && <nav class="custom-links" aria-label={ui.navigation.more}>{config.friendsPage.enabled && config.friendsPage.navigation && !config.navigation.links.some(link => navigationUrl(link.url) === withBase('friends/')) && <mdui-button variant="text" href={withBase('friends/')}>{ui.sidebar.friends}<Icon name="group--outlined" slot="end-icon" /></mdui-button>}{config.navigation.links.map(link => <mdui-button variant="text" href={navigationUrl(link.url)}>{link.label}<Icon name={externalUrl(link.url) ? 'north_east' : 'arrow_forward'} slot="end-icon" /></mdui-button>)}<noscript>{config.friendsPage.enabled && config.friendsPage.navigation && <p><a href={withBase('friends/')}>{ui.sidebar.friends}</a></p>}{config.navigation.links.map(link => <p><a href={navigationUrl(link.url)}>{link.label}</a></p>)}</noscript></nav>}
</div>
