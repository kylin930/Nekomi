---
import { config } from '../config/site';
import type { Post } from '../lib/posts';
import { dateLabel, externalUrl, postUrl, navigationUrl } from '../lib/urls';
import Avatar from './Avatar.astro';
import SearchField from './SearchField.astro';
import PostListItem from './PostListItem.astro';
import FriendItem from './FriendItem.astro';
import Icon from './Icon.astro';
interface Props { posts: Post[]; context: 'desktop' | 'mobile'; currentId?: string }
const { posts, context, currentId } = Astro.props;
const prefix = 'side-' + context;
const { site } = config;
const labels = { updates: '最近更新', friends: '友情链接', comments: '最近评论' };

const modules = config.layout.modules.filter(id => id !== 'search' || config.features.search);
const updates = [...posts].sort((a, b) => (b.data.updated || b.data.date).localeCompare(a.data.updated || a.data.date));
const friends = config.friends.filter(f => externalUrl(f.url));
const comments = config.comments.items.filter(c => c.author.trim() && c.excerpt.trim() && posts.some(p => p.id === c.postId)).sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
const tabs = config.layout.sidebarTabs.filter(id => id !== 'comments' || comments.length > 0);
const commentTime = (date: string) => new Intl.DateTimeFormat('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Shanghai' }).format(new Date(date));
---
<div data-sidebar={context}>
  {modules.map(module => <>
  {module === 'profile' && <>  <div class="profile">
    <div class="profile-brand">
      <Avatar src={site.avatar} fallback={site.avatarFallback} label={site.avatarAlt} />
      <div><p class="site-name">{site.name}</p><p class="site-tagline">{site.tagline}</p></div>
    </div>
    <p class="site-intro">{site.intro}</p>
  </div>
</>}
  {module === 'social' && (site.social.length > 0 || site.email) && <nav class="social-links" aria-label="联系与社交">{site.social.map(link => <mdui-button-icon href={navigationUrl(link.url)} title={link.name} aria-label={link.name}><Icon name={link.icon} /><span class="visually-hidden">{link.name}</span></mdui-button-icon>)}{site.email && <mdui-button-icon href={'mailto:' + site.email} title="电子邮件" aria-label="电子邮件"><Icon name="mail--outlined" /><span class="visually-hidden">电子邮件</span></mdui-button-icon>}</nav>}
  {module === 'search' && <SearchField />}
  {module === 'tabs' && tabs.length > 0 &&
  <mdui-tabs class="sidebar-tabs" value={tabs[0]} variant="secondary" full-width aria-label="侧栏内容">
    {tabs.map(id => <mdui-tab value={id} id={prefix + '-' + id} role="tab" aria-controls={prefix + '-' + id + '-panel'}>{labels[id]}</mdui-tab>)}
    {tabs.map(id => <>
    {id === 'updates' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="updates" id={prefix + '-updates-panel'} role="tabpanel" aria-labelledby={prefix + '-updates'}>
      <div class="side-panel-content"><div class="side-panel-heading"><span>最近的 {Math.min(posts.length, 5)} 篇记录</span></div>
        <mdui-list>{updates.slice(0, 5).map(post => <PostListItem post={post} description={dateLabel(post.data.date)} active={post.id === currentId} />)}</mdui-list>
      </div>
    </mdui-tab-panel>}
    {id === 'friends' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="friends" id={prefix + '-friends-panel'} role="tabpanel" aria-labelledby={prefix + '-friends'}>
      <div class="side-panel-content"><div class="side-panel-heading"><span>{friends.length} 个友邻</span><mdui-button variant="text" data-friends-all disabled={!friends.length}>查看全部<Icon name="arrow_forward" slot="end-icon" /></mdui-button></div>
        {friends.length ? <mdui-list class="friend-list">{friends.slice(0, 5).map(friend => <FriendItem friend={friend} />)}</mdui-list> : <p class="friend-empty">这里，留给有趣的邻居。<small>暂时还没有添加友链</small></p>}
      </div>
    </mdui-tab-panel>}
    {id === 'comments' && <mdui-tab-panel data-initial-active={id === tabs[0] || undefined} slot="panel" value="comments" id={prefix + '-comments-panel'} role="tabpanel" aria-labelledby={prefix + '-comments'}>
      <div class="side-panel-content"><div class="side-panel-heading"><span>最近的留言</span><span>{comments.length} 条</span></div>
        {comments.length ? <>
          <p class="comments-note">{config.comments.anchorsEnabled ? '打开文章，查看这条留言。' : '点击阅读留言对应的文章。'}</p>
          <mdui-list class="comment-list">{comments.slice(0, 4).map(comment => {
            const post = posts.find(p => p.id === comment.postId)!;
            const href = postUrl(post.id) + (config.comments.anchorsEnabled && comment.anchor ? '#' + encodeURIComponent(comment.anchor) : '');
            return <mdui-list-item rounded href={href} data-demo-comment={comment.demo || undefined}>
              <Avatar class="comment-avatar" slot="icon" src={comment.avatar} fallback={Array.from(comment.author)[0]} label={comment.author} />
              <div class="comment-copy"><div class="comment-byline"><strong>{comment.author}</strong><time datetime={comment.createdAt}>{commentTime(comment.createdAt)}</time></div><p class="comment-excerpt">{comment.excerpt}</p><p class="comment-post">{post.data.title}</p></div>
            </mdui-list-item>;
          })}</mdui-list>
        </> : <p class="friend-empty">还没有留言。<small>有新留言时会显示在这里</small></p>}
      </div>
    </mdui-tab-panel>}
    </>)}
  </mdui-tabs>}
  </>)}
  {config.navigation.links.length > 0 && <nav class="custom-links" aria-label="更多链接">{config.navigation.links.map(link => <mdui-button variant="text" href={navigationUrl(link.url)}>{link.label}<Icon name="north_east" slot="end-icon" /></mdui-button>)}<noscript>{config.navigation.links.map(link => <p><a href={navigationUrl(link.url)}>{link.label}</a></p>)}</noscript></nav>}
</div>
