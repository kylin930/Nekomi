---
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }
const { headings } = Astro.props;
---
<mdui-list class="toc-list">{headings.map(heading => <mdui-list-item rounded href={'#' + encodeURIComponent(heading.slug)} data-depth={heading.depth} style={'--toc-depth: ' + Math.max(0, heading.depth - 2)}>{heading.text}</mdui-list-item>)}</mdui-list>
