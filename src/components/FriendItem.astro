---
import { ui, message } from '../config/site';
import Avatar from './Avatar.astro';
import { externalUrl } from '../lib/urls';
interface Props { friend: { name: string; url: string; avatar?: string; description: string } }
const { friend } = Astro.props;
---
<mdui-list-item rounded href={externalUrl(friend.url)} target="_blank" rel="noopener noreferrer" headline={friend.name} description={friend.description} description-line="2">
  <span class="friend-name">{friend.name}</span>
  {friend.description && <span slot="description">{friend.description}</span>}
  <noscript><a href={externalUrl(friend.url)} target="_blank" rel="noopener noreferrer">{message(ui.common.visit, { name: friend.name })}</a></noscript>
  <Avatar class="friend-avatar" slot="icon" src={friend.avatar} fallback={Array.from(friend.name)[0]} label={friend.name} />
</mdui-list-item>
