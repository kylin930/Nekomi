---
import { config, ui, message } from '../config/site';
import { categoryRole } from '../lib/categories.mjs';
import { getPosts, facets, type Post } from '../lib/posts';
import { assetUrl, dateLabel, postUrl, facetUrl } from '../lib/urls';
import Icon from './Icon.astro';
import SiteImage from './SiteImage.astro';
interface Props { post: Post; latest: boolean }
const { post } = Astro.props;
const latest = Astro.props.latest && config.cards.latest;
const { title, excerpt, category, tags, date, cover } = post.data;
const tagGroups = !config.features.search ? facets(await getPosts(), 'tags') : [];
const tone = categoryRole(category, config.content.categoryColors);
const toneStyle = `--post-accent:var(--mdui-color-${tone},var(--mdui-color-primary));--post-accent-container:var(--mdui-color-${tone}-container,var(--mdui-color-primary-container));--post-on-accent-container:var(--mdui-color-on-${tone}-container,var(--mdui-color-on-primary-container))`;
---
<mdui-card variant={latest ? 'filled' : 'outlined'} class:list={['post-card', { 'post-latest': latest, 'post-cover-top': config.cards.cover === 'top' }]} style={toneStyle} data-post-id={post.id} data-tone={tone} data-search-text={[title, excerpt, category, ...tags].join(' ').toLocaleLowerCase(config.publishing.language)}>
  <article class="post-content"><div class="post-main"><div class="post-copy">
    <div class="post-meta">{config.cards.category && config.content.categories && <span class="post-category">{category}</span>}{config.cards.date && <time datetime={date}>{dateLabel(date)}</time>}{config.cards.example && post.data.demo && <span class="post-example">{ui.home.example}</span>}{config.cards.pinned && post.data.pinned && <span class="post-pinned">{ui.home.pinned}</span>}{latest && !post.data.pinned && <span class="post-new">{ui.home.latest}</span>}</div>
    <h2 class="post-title" data-shared-title={post.id}><a href={postUrl(post.id)} data-astro-prefetch="hover" data-post={post.id} data-highlight>{title}</a></h2>
    {config.cards.excerpt && <p class="post-excerpt" data-highlight>{excerpt}</p>}
  </div>{config.cards.cover !== 'none' && assetUrl(cover) && <a class="post-cover" data-shared-cover={post.id} href={postUrl(post.id)} data-astro-prefetch="hover" data-post={post.id} aria-label={message(ui.common.readTitle, { title })}><SiteImage src={cover} alt="" kind="cover" /></a>}</div>
  <div class="post-footer"><div class="post-tags">{(config.cards.tags && config.content.tags ? tags : []).map(tag => <mdui-chip variant="suggestion" data-query={config.features.search ? tag : undefined} href={!config.features.search ? facetUrl('tags', tagGroups.find(group => group.name === tag)!.slug) : undefined}>{tag}</mdui-chip>)}</div>{config.cards.readMore && <mdui-button variant="text" href={postUrl(post.id)} data-astro-prefetch="hover" data-post={post.id}>{ui.common.readMore}<Icon name="arrow_forward" slot="end-icon" /></mdui-button>}</div></article>
</mdui-card>
